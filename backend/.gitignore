# ========================================
# CogniCare Backend — .gitignore
# ========================================

# Dependencies
node_modules/
.pnpm-store/

# Environment Variables & Secrets
.env
.env.*
!.env.example
*.local

# Production Build Outputs
dist/
build/

# TypeScript Cache
*.tsbuildinfo
tsconfig.tsbuildinfo

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing & Coverage
coverage/
.nyc_output/

# Runtime Uploads & Temp Storage
uploads/
tmp/
temp/
*.tmp

# Operating System Files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# IDE & Editor Configs
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
